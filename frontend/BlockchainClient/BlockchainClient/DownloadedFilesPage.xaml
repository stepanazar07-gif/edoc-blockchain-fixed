<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlockchainClient.DownloadedFilesPage"
             Title="Полученные"
             BackgroundColor="#101828">
    <Grid Padding="18" RowDefinitions="Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Полученные файлы"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#F8FAFC"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Обновить"
                    Clicked="OnRefreshClicked"
                    BackgroundColor="#2E90FA"
                    TextColor="White"
                    CornerRadius="8" />
        </Grid>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Files}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#182230"
                            Stroke="#344054"
                            StrokeThickness="1"
                            Padding="14"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="{Binding FileName}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#F8FAFC" />
                            <Button Grid.Column="1"
                                    Text="Открыть"
                                    Clicked="OnOpenClicked"
                                    BackgroundColor="#12B76A"
                                    TextColor="White"
                                    CornerRadius="8" />
                            <Label Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding SenderId}"
                                   TextColor="#98A2B3"
                                   LineBreakMode="CharacterWrap" />
                            <Label Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding FileHash}"
                                   FontSize="12"
                                   TextColor="#FDB022"
                                   LineBreakMode="CharacterWrap" />
                            <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,*">
                                <Label Text="{Binding AcceptedAt}"
                                       TextColor="#D0D5DD" />
                                <Label Grid.Column="1"
                                       Text="{Binding FileSizeText}"
                                       TextColor="#D0D5DD"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Принятых файлов пока нет."
                       TextColor="#667085"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
