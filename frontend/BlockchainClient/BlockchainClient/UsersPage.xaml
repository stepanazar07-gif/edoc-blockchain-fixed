<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlockchainClient.UsersPage"
             Title="Пользователи"
             BackgroundColor="#101828">
    <Grid Padding="18" RowDefinitions="Auto,*" RowSpacing="12">
        <SearchBar x:Name="UserSearchBar"
                   Placeholder="Поиск по уникальному ID"
                   TextChanged="OnSearchTextChanged"
                   SearchButtonPressed="OnSearchPressed"
                   TextColor="#F8FAFC"
                   PlaceholderColor="#667085"
                   BackgroundColor="#182230" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Users}"
                        SelectionMode="Single"
                        SelectionChanged="OnUserSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#182230"
                            Stroke="#344054"
                            StrokeThickness="1"
                            Padding="14"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Уникальный ID"
                                   TextColor="#98A2B3"
                                   FontSize="12" />
                            <Label Text="{Binding Id}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#F8FAFC"
                                   LineBreakMode="CharacterWrap" />
                            <Label Text="Нажмите, чтобы выбрать файл для отправки"
                                   TextColor="#FDB022"
                                   FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Пользователи не найдены."
                       TextColor="#667085"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
