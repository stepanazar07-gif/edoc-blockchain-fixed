<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlockchainClient.IncomingTransfersPage"
             Title="Входящие"
             BackgroundColor="#101828">
    <Grid Padding="18" RowDefinitions="Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Входящие файлы"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#F8FAFC"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Обновить"
                    Clicked="OnRefreshClicked"
                    BackgroundColor="#2E90FA"
                    TextColor="White"
                    CornerRadius="8" />
        </Grid>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Transfers}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#182230"
                            Stroke="#344054"
                            StrokeThickness="1"
                            Padding="14"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding FileName}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#F8FAFC" />
                            <Label Text="{Binding SenderId}"
                                   TextColor="#98A2B3"
                                   LineBreakMode="CharacterWrap" />
                            <Grid ColumnDefinitions="*,*">
                                <Label Text="{Binding FileSizeText}"
                                       TextColor="#D0D5DD" />
                                <Label Grid.Column="1"
                                       Text="{Binding TransferDate}"
                                       TextColor="#D0D5DD"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Text="Принять"
                                        Clicked="OnAcceptClicked"
                                        BackgroundColor="#12B76A"
                                        TextColor="White"
                                        CornerRadius="8" />
                                <Button Grid.Column="1"
                                        Text="Отказаться"
                                        Clicked="OnDeclineClicked"
                                        BackgroundColor="#D92D20"
                                        TextColor="White"
                                        CornerRadius="8" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Новых входящих файлов нет."
                       TextColor="#667085"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
