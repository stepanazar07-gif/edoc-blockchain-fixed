<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlockchainClient.LoginPage"
             Title="Вход"
             BackgroundColor="#101828">
    <ScrollView>
        <Grid Padding="24" RowDefinitions="Auto,Auto,*" RowSpacing="18">
            <VerticalStackLayout Spacing="6">
                <Label Text="Блокчейн для документооборота"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="#F8FAFC" />
                <Label Text="Безопасное хранение и передача файлов по SHA-256"
                       FontSize="15"
                       TextColor="#98A2B3" />
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    BackgroundColor="#182230"
                    Stroke="#2E90FA"
                    StrokeThickness="1"
                    Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Профиль"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#F8FAFC" />
                    <Entry x:Name="NameEntry"
                           Placeholder="Имя для регистрации"
                           TextColor="#F8FAFC"
                           PlaceholderColor="#667085"
                           BackgroundColor="#101828" />
                    <Entry x:Name="AgeEntry"
                           Placeholder="Возраст"
                           Keyboard="Numeric"
                           TextColor="#F8FAFC"
                           PlaceholderColor="#667085"
                           BackgroundColor="#101828" />
                    <Entry x:Name="PhoneEntry"
                           Placeholder="Номер телефона"
                           Keyboard="Telephone"
                           TextColor="#F8FAFC"
                           PlaceholderColor="#667085"
                           BackgroundColor="#101828" />
                    <Entry x:Name="PasswordEntry"
                           Placeholder="Пароль"
                           IsPassword="True"
                           TextColor="#F8FAFC"
                           PlaceholderColor="#667085"
                           BackgroundColor="#101828" />

                    <Button Text="Войти"
                            Clicked="OnLoginClicked"
                            BackgroundColor="#2E90FA"
                            TextColor="White"
                            CornerRadius="8" />
                    <Button Text="Создать аккаунт"
                            Clicked="OnRegisterClicked"
                            BackgroundColor="#12B76A"
                            TextColor="White"
                            CornerRadius="8" />

                    <Label x:Name="MessageLabel"
                           Text=""
                           TextColor="#FDB022"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
