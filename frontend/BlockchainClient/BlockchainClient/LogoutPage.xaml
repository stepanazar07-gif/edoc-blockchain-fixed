<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlockchainClient.LogoutPage"
             Title="Выход"
             BackgroundColor="#101828">
    <VerticalStackLayout Spacing="16" Padding="24" VerticalOptions="Center">
        <Label Text="Завершить текущую сессию?"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="#F8FAFC"
               HorizontalOptions="Center" />
        <Button Text="Выйти"
                Clicked="OnLogoutClicked"
                BackgroundColor="#D92D20"
                TextColor="White"
                CornerRadius="8" />
        <Button Text="Отмена"
                Clicked="OnCancelClicked"
                BackgroundColor="#2E90FA"
                TextColor="White"
                CornerRadius="8" />
    </VerticalStackLayout>
</ContentPage>
