<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlockchainClient.UploadPage"
             Title="Загрузка"
             BackgroundColor="#101828">
    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Border BackgroundColor="#182230"
                Stroke="#2E90FA"
                StrokeThickness="1"
                Padding="16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="12">
                <Label Text="Загрузить файл"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#F8FAFC" />
                <Button Text="Выбрать файл"
                        Clicked="OnSelectFileClicked"
                        BackgroundColor="#2E90FA"
                        TextColor="White"
                        CornerRadius="8" />
                <Label x:Name="FileInfoLabel"
                       Text="Файл не выбран"
                       TextColor="#98A2B3"
                       LineBreakMode="WordWrap" />
                <Label x:Name="HashPreviewLabel"
                       Text=""
                       TextColor="#FDB022"
                       LineBreakMode="CharacterWrap" />
                <ActivityIndicator x:Name="UploadIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="#12B76A" />
                <Button x:Name="UploadButton"
                        Text="Загрузить"
                        Clicked="OnUploadClicked"
                        BackgroundColor="#12B76A"
                        TextColor="White"
                        CornerRadius="8"
                        IsEnabled="False" />
            </VerticalStackLayout>
        </Border>

        <Label Grid.Row="1"
               Text="Последние добавленные файлы"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="#F8FAFC" />

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding UploadedDocuments}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#182230"
                            Stroke="#344054"
                            StrokeThickness="1"
                            Padding="14"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding FileName}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#F8FAFC"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding FileSizeText}"
                                   TextColor="#98A2B3" />
                            <Label Text="{Binding FileHash}"
                                   TextColor="#FDB022"
                                   FontSize="12"
                                   LineBreakMode="CharacterWrap" />
                            <Grid ColumnDefinitions="*,*">
                                <Label Text="{Binding UploadDate}"
                                       TextColor="#D0D5DD" />
                                <Label Grid.Column="1"
                                       Text="{Binding UploadTime}"
                                       TextColor="#D0D5DD"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                            <Label Text="{Binding UploadedBy}"
                                   TextColor="#12B76A" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="После загрузки карточки появятся здесь."
                       TextColor="#667085"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
