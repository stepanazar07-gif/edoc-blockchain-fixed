<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlockchainClient.HistoryPage"
             Title="История"
             BackgroundColor="#101828">
    <Grid Padding="18" RowDefinitions="Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="История операций"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#F8FAFC"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Очистить"
                    Clicked="OnClearClicked"
                    BackgroundColor="#D92D20"
                    TextColor="White"
                    CornerRadius="8" />
        </Grid>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Records}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#182230"
                            Stroke="#344054"
                            StrokeThickness="1"
                            Padding="14"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Status}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#F8FAFC" />
                            <Label Text="{Binding FileName}"
                                   TextColor="#D0D5DD" />
                            <Label Text="{Binding Details}"
                                   TextColor="#98A2B3"
                                   LineBreakMode="CharacterWrap" />
                            <Label Text="{Binding FileHash}"
                                   FontSize="12"
                                   TextColor="#FDB022"
                                   LineBreakMode="CharacterWrap" />
                            <Label Text="{Binding Timestamp, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                   TextColor="#667085" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="История пока пуста."
                       TextColor="#667085"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
